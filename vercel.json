{
  "functions": {
    "api/stripe/webhook.js": {
      "maxDuration": 10
    },
    "api/stripe/connect-webhook.js": {
      "maxDuration": 10
    },
    "api/cron/daily-email.js": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/assets/email/sineday-daily.vcf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/vcard; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "inline; filename=\"SineDay-Daily.vcf\""
        }
      ]
    },
    {
      "source": "/daily/confirm",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/daily-confirm.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/daily",
      "destination": "/daily.html"
    },
    {
      "source": "/daily/confirm",
      "destination": "/daily-confirm.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily-email",
      "schedule": "* * * * *"
    }
  ]
}
